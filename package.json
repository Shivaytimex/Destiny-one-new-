{
  "name": "destinyone",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm test && pnpm build:web",
    "export:web": "expo export --platform web --output-dir dist && node scripts/fix-expo-netlify-fonts.mjs",
    "build": "pnpm build:web",
    "build:web": "expo export --platform web --output-dir dist && node scripts/fix-expo-netlify-fonts.mjs",
    "release:check": "pnpm check"
  },
  "dependencies": {
    "@countrystatecity/countries-browser": "^1.0.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo-google-fonts/satisfy": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@stripe/stripe-react-native": "0.63.0",
    "@supabase/supabase-js": "^2.58.0",
    "expo": "~55.0.0",
    "expo-audio": "~55.0.15",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.37",
    "expo-device": "~55.0.18",
    "expo-document-picker": "~55.0.15",
    "expo-font": "~55.0.4",
